<div class="sabkc-dialog-form">
  <p>{{localize "SABKC.EditState.Actor" actor=actorName}}</p>
  <label>
    <span>{{localize "SABKC.Common.DisadvantageCharges"}}</span>
    <input type="number" name="disadvantageCharges" min="0" step="1" required value="{{disadvantageCharges}}">
  </label>
  <label>
    <span>{{localize "SABKC.Common.D4Charges"}}</span>
    <input type="number" name="d4Charges" min="0" step="1" required value="{{d4Charges}}">
  </label>
  <label>
    <span>{{localize "SABKC.Common.SessionViolations"}}</span>
    <input type="number" name="violationsThisSession" min="0" step="1" required value="{{violationsThisSession}}">
  </label>
</div>
